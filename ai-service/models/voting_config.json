{
  "version": 1,
  "note": "Multi-model voting. Probability excludes reg (capacity) weights; denominator 15.",
  "holdout": "none",
  "n_folds": 6,
  "seed": 42,
  "xgb_cat_weights": { "xgb": 0.5, "cat": 0.5 },
  "threshold": {
    "status": "ops",
    "default_threshold": 0.4,
    "note": "quality_defect = 1 if probability >= 0.4 else 0 (last step)"
  },
  "standard_residual": {
    "caution": 3000,
    "severe": 3500,
    "usl_spare": 4000,
    "score_formula": "clip((r - 3000) / (4000 - 3000), 0, 1)"
  },
  "capacity": {
    "denominator": 11,
    "members": [
      { "id": "reg_d50", "weight": 1, "dir": "models/voting/reg_d50" },
      { "id": "reg_d90", "weight": 1, "dir": "models/voting/reg_d90" },
      { "id": "reg_feature", "weight": 2, "dir": "models/voting/reg_feature" },
      { "id": "cathode_feature_cap", "weight": 3, "dir": "models/voting/cathode_feature/cap" },
      { "id": "cathode_special_cap", "weight": 4, "dir": "models/voting/cathode_special/cap" }
    ]
  },
  "residual_li": {
    "denominator": 11,
    "members": [
      { "id": "residual_d50", "weight": 1, "dir": "models/voting/residual_d50" },
      { "id": "residual_d90", "weight": 1, "dir": "models/voting/residual_d90" },
      { "id": "residual_feature", "weight": 2, "dir": "models/voting/residual_feature" },
      { "id": "cathode_feature_res", "weight": 3, "dir": "models/voting/cathode_feature/res" },
      { "id": "cathode_special_res", "weight": 4, "dir": "models/voting/cathode_special/res" }
    ]
  },
  "probability": {
    "denominator": 15,
    "excludes": ["reg_d50", "reg_d90", "reg_feature"],
    "members": [
      { "id": "clf_d50", "weight": 1, "kind": "clf_proba", "dir": "models/voting/clf_d50" },
      { "id": "clf_d90", "weight": 1, "kind": "clf_proba", "dir": "models/voting/clf_d90" },
      { "id": "clf_feature", "weight": 2, "kind": "clf_proba", "dir": "models/voting/clf_feature" },
      { "id": "residual_d50", "weight": 1, "kind": "residual_score", "dir": "models/voting/residual_d50" },
      { "id": "residual_d90", "weight": 1, "kind": "residual_score", "dir": "models/voting/residual_d90" },
      { "id": "residual_feature", "weight": 2, "kind": "residual_score", "dir": "models/voting/residual_feature" },
      { "id": "cathode_feature_clf", "weight": 3, "kind": "clf_proba_cascade", "dir": "models/voting/cathode_feature/clf" },
      { "id": "cathode_special_clf", "weight": 4, "kind": "clf_proba_cascade", "dir": "models/voting/cathode_special/clf" }
    ]
  }
}
