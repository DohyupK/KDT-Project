# Copy to .env and fill values. Never commit real keys.
# Git ignores **/.env — only this .env.example is safe to commit.

# Enable LLM compose (otherwise template replies)
CHAT_USE_LLM=0

# Length-based routing (user message character count)
# len <= CHAT_LEN_GEMINI (300)     → Groq (Llama)
# CHAT_LEN_GEMINI < len <= CHAT_LEN_PRO (500) → Gemini Flash
# len > CHAT_LEN_PRO               → Gemini Pro
# Gemini fail → Groq + notice
CHAT_LEN_GEMINI=300
CHAT_LEN_PRO=500

# Groq (key usually starts with gsk_) — short messages
GROQ_API_KEY=
CHAT_GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini — longer messages (Flash / Pro by length)
GOOGLE_API_KEY=
CHAT_GEMINI_FLASH_MODEL=gemini-2.0-flash
CHAT_GEMINI_PRO_MODEL=gemini-2.5-pro

# Local vLLM — security tab ONLY (NOT used by general /chat Groq/Gemini)
# OpenAI-compatible server on :8001 (FastAPI ai-service stays on :8800)
CHAT_VLLM_BASE_URL=http://127.0.0.1:8001/v1
CHAT_VLLM_MODEL=local-model
# Optional alias: VLLM_BASE_URL= (same meaning as CHAT_VLLM_BASE_URL)

# Secure docs directory (default: monorepo root Documents/)
# SECURE_DOCS_DIR=

# Secure generate (0=extractive, 1=local LLM then extractive fallback)
# SECURE_GENERATE=0
# SECURE_SELF_QUERY=0
# SECURE_VLLM_TIMEOUT=45
# SECURE_VLLM_MAX_TOKENS=256
# SECURE_DOCS_WATCH=1
# SECURE_DOCS_WATCH_DEBOUNCE=4.0

# MariaDB multi-turn (same DB as backend) — do not commit real passwords elsewhere
# DB_HOST=
# DB_PORT=3306
# DB_USER=
# DB_PASSWORD=
# DB_NAME=
# Or: DATABASE_URL=mysql+pymysql://user:pass@host:3306/dbname

# Layer-1 short-term memory (no LLM summarization)
# CHAT_HISTORY_WINDOW=6
# CHAT_HISTORY_MSG_MAX_CHARS=400
# CHAT_HISTORY_MAX_CHARS=2000

# Layer-2 long-term memory (Qdrant semantic pruning, CPU bge-m3)
# CHAT_HISTORY_QDRANT_COLLECTION=chat_history_collection
# CHAT_HISTORY_SEMANTIC_TOP_K=3

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000

# What-if grid (Cold start; humidity / sintering_temp deltas, comma-separated)
WHATIF_HUMIDITY_DELTAS=-15,-10,-5,0,5
WHATIF_TEMP_DELTAS=-10,-5,0,5,10
