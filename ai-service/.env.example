# Copy to .env and fill values. Never commit real keys.
# Git ignores **/.env — only this .env.example is safe to commit.

# Enable LLM compose (otherwise template replies)
CHAT_USE_LLM=0

# Length-based routing (user message character count)
# len <= CHAT_LEN_GEMINI (300)     → Groq (Llama)
# CHAT_LEN_GEMINI < len <= CHAT_LEN_PRO (500) → Gemini Flash
# len > CHAT_LEN_PRO               → Gemini Pro
# Gemini fail → Groq + notice
CHAT_LEN_GEMINI=300
CHAT_LEN_PRO=500

# Groq (key usually starts with gsk_) — short messages
GROQ_API_KEY=
CHAT_GROQ_BASE_URL=https://api.groq.com/openai/v1
CHAT_GROQ_MODEL=llama-3.1-8b-instant

# Google Gemini — longer messages (Flash / Pro by length)
GOOGLE_API_KEY=
CHAT_GEMINI_FLASH_MODEL=gemini-2.0-flash
CHAT_GEMINI_PRO_MODEL=gemini-2.5-pro

# Local vLLM — security tab only (NOT used by general /chat compose)
CHAT_VLLM_BASE_URL=http://127.0.0.1:8001/v1

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000
