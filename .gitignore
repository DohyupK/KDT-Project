.DS_Store
Thumbs.db
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
.venv/
venv/

# Node
node_modules/
dist/
.next/

# Local runtime / one-off dumps (do not commit)
temp/
frontend/feeder_state.json
