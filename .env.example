# Copy to the monorepo root `.env`. Never commit real passwords or API keys.
# PM2: if the process cannot find this file, set ROOT_ENV_PATH to this file's
# absolute path in the ecosystem `env` (not inside `.env` — chicken-and-egg).

PORT=3001

# PC에서 npm run dev: http://localhost:3000
# Lightsail(Nginx :80)에서 앱을 열 때: http://<퍼블릭IP> (끝 슬래시 없이)
# 서버에서 next dev 를 쓸 때 HMR /_next 청크 origin 도 이 값을 봄 (allowedDevOrigins)
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN=http://localhost:3000
# 공인 IP가 CORS_* 와 다를 때 (예: http://3.38.135.192)
# ALLOWED_DEV_ORIGINS=3.38.135.192

# memory | sqlite | mariadb
CHAT_STORE=mariadb

# MariaDB
# AWS 앱(같은 기계): 127.0.0.1 — 방화벽 3306 닫기
# 이 PC 워커: npm run security-pc 가 ssh -L 3306 을 열면 여기도 127.0.0.1
# (방화벽에 3306을 열지 말 것. AWS .env 와 이 PC .env 를 섞지 말 것)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=kdt
DB_PASSWORD=
DB_NAME=kdt_project

JWT_SECRET=change-this-secret-in-production

AI_SERVICE_URL=http://127.0.0.1:8800
SECURITY_KEYWORDS=

LLM_KEYS_ENCRYPTION_KEY=change-me-to-a-long-random-secret

CHAT_USE_LLM=1
CHAT_LEN_GEMINI=300
CHAT_LEN_PRO=500

# GROQ_API_KEY=
# GOOGLE_API_KEY=

# vLLM: 이 PC에서만. 보안 챗은 AWS가 :8001을 안 친다 (PC 워커).
# AWS: npm run dev (워커 안 켬). 이 PC: npm run security-pc
# 터널용(선택): SECURITY_PC_KEY_PATH · SECURITY_PC_PUBLIC_HOST
# SECURITY_PC_KEY_PATH=
# SECURITY_PC_PUBLIC_HOST=
CHAT_VLLM_BASE_URL=http://127.0.0.1:8001/v1
CHAT_VLLM_MODEL=gemma
SECURE_SELF_QUERY=0
SECURE_GENERATE=1
SECURE_VLLM_TIMEOUT=90
SECURE_VLLM_MAX_TOKENS=1024
# SECURITY_WORKER_POLL_SEC=0.5
# SECURITY_QUEUE_WAIT_SEC=180

QDRANT_URL=http://127.0.0.1:6333
N8N_ISSUE_REPORT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/issue-report
# N8N_WEBHOOK_SECRET=
# ISSUE_REPORT_MAIL_ENABLED=1
# ISSUE_REPORT_MAIL_FROM=
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=

# Grafana가 떠 있는 호스트 (iframe은 브라우저가 직접 연다)
NEXT_PUBLIC_GRAFANA_HOST=127.0.0.1
NEXT_PUBLIC_GRAFANA_PORT=4000

# ai-service 멀티턴. 서버에서는 암호만 바꿔 127.0.0.1 유지
# DATABASE_URL=mysql+pymysql://kdt:암호@127.0.0.1:3306/kdt_project?charset=utf8mb4
