# Copy to .env. Never commit real passwords or API keys.

PORT=3001
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# memory | sqlite | mariadb — team shared Ubuntu DB: use mariadb
CHAT_STORE=mariadb

# MariaDB / MySQL (auth + chat + control)
# 로컬만: 127.0.0.1
# 팀 공용(Lightsail Ubuntu MariaDB): DB_HOST=<Public_또는_Static_IP>, 계정은 서버에서 만든 앱 유저(예: kdt)
# 절차: docs/guides/login-ubuntu-mariadb.md  —  .env 는 Git에 커밋하지 말 것
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kdt_project

JWT_SECRET=change-this-secret-in-production

# Comma-separated user_id values that may answer inquiries / see private inquiries
# ADMIN_USER_IDS=admin01,20250226

AI_SERVICE_URL=http://127.0.0.1:8800
# Root npm run dev sets AI_SERVICE_AUTOSTART=0 (dev:ai owns :8800). Alone backend may set 1.
# AI_SERVICE_AUTOSTART=0

# Documents OCR/watchdog Python daemon (ai-service/scripts/run_document_watcher.py)
DOCUMENT_WATCHER_AUTOSTART=1

SECURITY_KEYWORDS=

# Master key for AES-GCM encrypting company LLM API keys in DB/data/llm_keys.sqlite
# (not a company API key). Min 16 chars. Required for /api/llm-keys and chat Auto. Never commit.
LLM_KEYS_ENCRYPTION_KEY=change-me-to-a-long-random-secret
# Optional overrides (defaults under repo DB/data/):
# LLM_KEYS_SQLITE_PATH=
# CHAT_SQLITE_PATH=
# CONTROL_SQLITE_PATH=

# Optional: absolute path to cathode_clf_data.csv (default: ../ai-service/data/...)
# LOT_CSV_PATH=

# Grafana SPC embeds: set panel URLs in frontend management/page.tsx (GRAFANA_PANEL_URLS).
# Public/anonymous embed assumed — no backend guest-token. If auth is required later, add here.
# GRAFANA_HOST=

# Issue report mail (n8n → Google Cloud Gmail API). Root .env only. Never put the JSON body here.
# ISSUE_REPORT_MAIL_ENABLED=1
# ISSUE_REPORT_MAIL_FROM=noreply@example.com
# N8N_ISSUE_REPORT_WEBHOOK_URL=http://127.0.0.1:5678/webhook/issue-report
# N8N_WEBHOOK_SECRET=kdt-local-n8n-webhook
# Path to GCP service-account JSON (do not copy the file into this repo)
# GOOGLE_MAIL_SERVICE_ACCOUNT_FILE=C:\path\to\service-account.json
# Workspace user to send as (Gmail domain-wide delegation)
# GOOGLE_MAIL_DELEGATED_USER=noreply@example.com
# OAuth web client JSON path (do not copy the file into this repo). ID/secret from that file.
# GMAIL_OAUTH_CLIENT_FILE=C:\path\to\client_secret.json
# GMAIL_CLIENT_ID=
# GMAIL_CLIENT_SECRET=
# GMAIL_REFRESH_TOKEN=
