# Copy to .env. Never commit real passwords or API keys.

PORT=3001
CORS_ORIGINS=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# memory | sqlite | mariadb — team shared Ubuntu DB: use mariadb
CHAT_STORE=mariadb

# MariaDB / MySQL (auth + chat + control + encrypted LLM keys)
# 로컬만: 127.0.0.1
# 팀 공용(Lightsail Ubuntu MariaDB): DB_HOST=<Public_또는_Static_IP>, 계정은 서버에서 만든 앱 유저(예: kdt)
# 절차: docs/guides/login-ubuntu-mariadb.md  —  .env 는 Git에 커밋하지 말 것
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=kdt_project

JWT_SECRET=change-this-secret-in-production

AI_SERVICE_URL=http://127.0.0.1:8800
SECURITY_KEYWORDS=

# Master key for AES-GCM encrypting company LLM API keys in MariaDB llm_api_keys
# (not a company API key). Min 16 chars. Team must share the same value. Never commit.
# Required for /api/llm-keys and chat Auto.
LLM_KEYS_ENCRYPTION_KEY=change-me-to-a-long-random-secret
