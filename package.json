{
  "name": "kdt-project",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n ai,backend,frontend -c magenta,green,cyan \"npm run dev:ai\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:ai": "node ai-service/scripts/dev-ai.cjs",
    "dev:backend": "node scripts/dev-backend.cjs",
    "dev:frontend": "npm --prefix frontend run dev",
    "security-pc": "powershell -ExecutionPolicy Bypass -File ./scripts/security-pc.ps1"
  },
  "devDependencies": {
    "concurrently": "^9"
  }
}
