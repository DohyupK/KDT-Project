{
  "name": "kdt-project",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n ai,backend,frontend -c magenta,green,cyan \"npm run dev:ai\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:ai": "cd ai-service && python -m uvicorn app.main:app --host 127.0.0.1 --port 8800",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev"
  },
  "devDependencies": {
    "concurrently": "^9"
  }
}
